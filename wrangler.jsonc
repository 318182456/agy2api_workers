{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agy2api_workers",
  "main": "src/index.js",
  "placement": {
    "region": "aws:ap-northeast-1"
  },
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gcli2api",
      "database_id": "026ab89e-8c6d-4bf0-944c-09074e16d2df",
      "remote": true,
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "MAX_CREDENTIAL_ATTEMPTS": "3",
    "USAGE_STORAGE_MODE": "aggregate",
    "ANTIGRAVITY_CLIENT_ID": "1071006060591-tmhssin2h21lcre235vtolojh4g403ep.apps.googleusercontent.com",
    "ANTIGRAVITY_CLIENT_SECRET": "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"
  },
  "compatibility_flags": ["enable_request_signal", "global_fetch_strictly_public"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "620f83e9434c4a2a815cbc3d871e3ce7"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "TELEMETRY",
        "class_name": "TelemetryBuffer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-telemetry",
      "new_sqlite_classes": ["TelemetryBuffer"]
    }
  ]
}
