# Required: set two different long random passwords. No default passwords.
API_PASSWORD=
PANEL_PASSWORD=

# Optional: override the default OAuth clients already configured in wrangler.jsonc vars.
# Uncomment only to use a custom matching client ID / secret pair.
# GEMINICLI_CLIENT_ID=
# GEMINICLI_CLIENT_SECRET=
# ANTIGRAVITY_CLIENT_ID=
# ANTIGRAVITY_CLIENT_SECRET=
